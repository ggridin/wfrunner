{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wfrunner.local/schemas/compiled-plan.schema.json",
  "title": "WaterfallRunner Compiled Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_file",
    "source_sha256",
    "plan_description",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source_file": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_description": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/compiledStep"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stepId": {
      "type": "string",
      "pattern": "^STEP-[0-9]{3}(\\.[0-9]{3})?$"
    },
    "compiledStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "prompt",
        "metadata"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stepId"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "prompt": {
          "type": "string"
        },
        "review_guidance": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/stepMetadata"
        }
      }
    },
    "stepMetadata": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "title",
        "type"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/stepId"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "type": "string",
          "enum": [
            "IMPLEMENTATION",
            "HUMAN_GATE",
            "ANALYSIS"
          ]
        }
      }
    }
  }
}
